# ─── Python ───────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
venv/
.venv/
env/
.env

# ─── Runtime data (generated by the app) ──────────────────
# Alert snapshots, clips and JSON sidecars are runtime output.
# Keep the folder but ignore its contents.
backend/alerts/*.jpg
backend/alerts/*.jpeg
backend/alerts/*.png
backend/alerts/*.mp4
backend/alerts/*.json

# Uploaded and processed videos
backend/uploads/
backend/outputs/

# Test frames generated during dev
backend/test_frame.jpg

# ─── ML model weights (too large for git) ─────────────────
# Train via ml_model/train_autoencoder.ipynb on Google Colab,
# then place the output files in backend/models/.
backend/models/*.h5
backend/models/*.keras
backend/models/*.npy
backend/models/*.pb
backend/models/saved_model/

# YOLO weights (auto-downloaded by ultralytics on first run)
backend/*.pt

# ─── OS / IDE ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# ─── Jupyter / Colab checkpoints ──────────────────────────
.ipynb_checkpoints/
ml_model/.ipynb_checkpoints/
